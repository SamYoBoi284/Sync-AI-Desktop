{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sync AI Desktop",
  "version": "0.1.0",
  "identifier": "com.syncai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sync AI Desktop",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
